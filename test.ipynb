   "source": [
    "import numpy as np\n",
    "\n",
    "X = np.array([[1.0, 0.0],\n",
    "              [0.9, 0.1],\n",
    "              [0.0, 1.0]])\n",
    "\n",
    "scores = X @ X.T\n",
    "weights = np.exp(scores)\n",
    "weights /= weights.sum(axis=1, keepdims=True)\n",
    "output = weights @ X\n",
    "\n",
    "print(weights.round(2))\n",
    "print(output.round(2))"
   ]
